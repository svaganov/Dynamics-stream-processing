<mxfile host="app.diagrams.net" type="device">
  <diagram name="Хост и воркеры" id="hostworkers">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Взаимодействие хостовой машины и контейнеров-воркеров (фактическая схема: панель на хосте, воркеры в Docker)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1150" height="30" as="geometry"/></mxCell>
        <mxCell id="browser" value="БРАУЗЕР&lt;br&gt;дашборд · страница станции&lt;br&gt;подслушка A/B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="srcs" value="ИСТОЧНИКИ&lt;br&gt;входные HTTP-потоки&lt;br&gt;(интернет-радио,&lt;br&gt;AAC / MP3, ICY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="hostbox" value="ХОСТ-МАШИНА · Windows + Docker Desktop (на Linux — то же самое, демон нативный)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="1010" height="650" as="geometry"/></mxCell>
        <mxCell id="panel" value="ПАНЕЛЬ УПРАВЛЕНИЯ&lt;br&gt;хостовый процесс: python app.py&lt;br&gt;HTTP :9101 (по умолч. :8770)&lt;br&gt;streams.json — реестр станций&lt;br&gt;генерация runtime/&amp;lt;id&amp;gt;.liq&lt;br&gt;Docker SDK — оркестрация воркеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="290" height="190" as="geometry"/></mxCell>
        <mxCell id="listen" value="ПОДСЛУШКА A/B&lt;br&gt;FFmpeg-процессы на хосте&lt;br&gt;вход / выход → MP3 в браузер&lt;br&gt;(нужен ffmpeg на хосте)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="daemon" value="DOCKER-ДЕМОН · docker.sock / Docker API" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="wrkbox" value="КОНТЕЙНЕРЫ-ВОРКЕРЫ · по одному на станцию · открытых портов наружу нет" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="560" height="440" as="geometry"/></mxCell>
        <mxCell id="w1" value="audio-worker-station-1 · образ audio-worker:2.4.2 (Liquidsoap)&lt;br&gt;bind-mount: runtime/station-1.liq → /station.liq&lt;br&gt;telnet :1234 ← опубликован на 127.0.0.1:&amp;lt;случайный порт&amp;gt;&lt;br&gt;input.http → DSP → live-BYPASS → резерв → output.icecast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="520" height="160" as="geometry"/></mxCell>
        <mxCell id="w2" value="audio-worker-station-2 · образ audio-worker:2.4.2 (Liquidsoap)&lt;br&gt;bind-mount: runtime/station-2.liq → /station.liq&lt;br&gt;telnet :1234 ← опубликован на 127.0.0.1:&amp;lt;случайный порт&amp;gt;&lt;br&gt;input.http → DSP → live-BYPASS → резерв → output.icecast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="520" height="160" as="geometry"/></mxCell>
        <mxCell id="ice" value="ICECAST&lt;br&gt;ваш сервер:&lt;br&gt;127.0.0.1:8800&lt;br&gt;или внешний хостинг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="note1" value="Адреса 127.0.0.1 / localhost в конфиге станции (источник, Icecast, резервный URL) панель переписывает в скрипте воркера на host.docker.internal — из контейнера loopback указывал бы на сам контейнер." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="290" y="735" width="1010" height="30" as="geometry"/></mxCell>
        <mxCell id="note2" value="Telnet-порты воркеров публикуются только на 127.0.0.1 хоста — снаружи недоступны; панель держит одну постоянную telnet-сессию на воркера (опрос статусов не засоряет лог)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="290" y="770" width="1010" height="30" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTP :9101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="panel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="Docker API · docker.sock — create / start / stop / logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="panel" target="daemon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="run · bind .liq · publish telnet на 127.0.0.1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="daemon" target="wrkbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="telnet (постоянная сессия): gain · EQ · динамика · секции · BYPASS · статусы входа/выхода" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="panel" target="w1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="263" /><mxPoint x="660" y="290" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="входной поток (pull, input.http)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="srcs" target="w1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="465" /><mxPoint x="660" y="370" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="AAC/ADTS → /test2.aacp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="ice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="AAC/ADTS → /test.aacp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="ice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="A · вход" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="srcs" target="listen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="B · выход" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ice" target="listen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="680" /><mxPoint x="620" y="680" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="запуск FFmpeg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="panel" target="listen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
