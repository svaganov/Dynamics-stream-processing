<mxfile host="app.diagrams.net" type="device">
  <diagram name="Архитектура" id="arch2">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Архитектура мультипоточной системы: N входных потоков → независимые пайплайны (FFmpeg / Liquidsoap) → Icecast" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="panelbox" value="ПАНЕЛЬ УПРАВЛЕНИЯ (CONTROL PLANE)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="760" height="175" as="geometry"/></mxCell>
        <mxCell id="pui" value="UI ПАНЕЛИ&lt;br&gt;переключатель станций&lt;br&gt;вкладки · STREAM INFO&lt;br&gt;выбор движка · A/B-прослушка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="112" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="preg" value="РЕЕСТР ПОТОКОВ — streams.json&lt;br&gt;станция = параметры обработки&lt;br&gt;«добавить / удалить» без&lt;br&gt;рестарта работающих станций" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="112" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="peng" value="ДВИЖОК ЗАПУСКА (engine)&lt;br&gt;ffmpeg — ProcessManager&lt;br&gt;liquidsoap — DockerWorkerManager&lt;br&gt;модель данных та же,&lt;br&gt;меняется только запуск" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="112" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="dockerd" value="DOCKER-ДЕМОН · docker.sock / Docker API —&lt;br&gt;создаёт и уничтожает воркеры audio-worker-&amp;lt;id&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="262" width="500" height="56" as="geometry"/></mxCell>
        <mxCell id="srcs" value="ВХОДНЫЕ ПОТОКИ · N СТАНЦИЙ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="190" height="290" as="geometry"/></mxCell>
        <mxCell id="st1" value="СТАНЦИЯ 1&lt;br&gt;AAC / HE-AAC&lt;br&gt;метаданные ICY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="390" width="160" height="64" as="geometry"/></mxCell>
        <mxCell id="st2" value="СТАНЦИЯ 2&lt;br&gt;MP3&lt;br&gt;метаданные ICY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="482" width="160" height="64" as="geometry"/></mxCell>
        <mxCell id="stn" value="СТАНЦИЯ N&lt;br&gt;любой формат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="55" y="574" width="160" height="52" as="geometry"/></mxCell>
        <mxCell id="pipesbox" value="НЕЗАВИСИМЫЕ ПАЙПЛАЙНЫ (DATA PLANE)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="760" height="290" as="geometry"/></mxCell>
        <mxCell id="pipe1" value="FFMPEG-ПРОЦЕСС #1 · СТАНЦИЯ 1 — engine = ffmpeg&lt;br&gt;декод PCM → EQ 10 полос → усиление → компрессор → loudnorm (LUFS) → лимитер → AAC (libfdk_aac)&lt;br&gt;свой watchdog · лог · рестарты · BYPASS · StreamTitle → metadata-relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="388" width="720" height="86" as="geometry"/></mxCell>
        <mxCell id="pipe2" value="LIQUIDSOAP-ВОРКЕР #2 · СТАНЦИЯ 2 — engine = liquidsoap&lt;br&gt;контейнер audio-worker-&amp;lt;id&amp;gt; · station.liq генерирует панель&lt;br&gt;input.http → EQ → gain → компрессор → loudnorm → лимитер → FDK-AAC → Icecast · метаданные сквозь конвейер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="484" width="720" height="86" as="geometry"/></mxCell>
        <mxCell id="pipen" value="ПАЙПЛАЙН #N · СТАНЦИЯ N — клон шаблона · движок на выбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="580" width="720" height="48" as="geometry"/></mxCell>
        <mxCell id="distbox" value="ДИСТРИБУЦИЯ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="345" width="390" height="290" as="geometry"/></mxCell>
        <mxCell id="ice" value="ICECAST / CDN-ПРОВАЙДЕР&lt;br&gt;приём потоков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="390" width="350" height="64" as="geometry"/></mxCell>
        <mxCell id="mounts" value="ТОЧКИ МОНТИРОВАНИЯ&lt;br&gt;/station-1&lt;br&gt;/station-2&lt;br&gt;… /station-N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="480" width="350" height="108" as="geometry"/></mxCell>
        <mxCell id="srcnote" value="Каждый источник независим — добавление / удаление на ходу" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="isnote" value="Изоляция сбоев: падение одного пайплайна не затрагивает остальные — watchdog перезапускает только его" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="300" y="645" width="760" height="30" as="geometry"/></mxCell>
        <mxCell id="distnote" value="Каждый выход — отдельная точка на CDN, своя задержка 0,5–1,5 с" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1130" y="645" width="390" height="50" as="geometry"/></mxCell>
        <mxCell id="latnote" value="Бюджет задержки узла ≈ 0,5–1,5 с на поток — не растёт с числом станций" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="capnote" value="Ёмкость: ~1–3% ядра и 30–60 МБ на пайплайн → 20–40 станций на 4-ядерной машине; контейнеры-воркеры + ~15 МБ на контейнер" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTP-поток" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st1" target="pipe1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
