<mxfile host="app.diagrams.net" type="device">
  <diagram name="Архитектура" id="arch1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Архитектура конвейера воркера: приём → DSP → live-BYPASS → резерв → Icecast (Liquidsoap 2.4.2, Docker-контейнер)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1250" height="30" as="geometry"/></mxCell>
        <mxCell id="src" value="ВХОДНОЙ ПОТОК&lt;br&gt;AAC / HE-AAC / MP3&lt;br&gt;метаданные ICY (StreamTitle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="lsbox" value="УЗЕЛ ОБРАБОТКИ · Docker-контейнер audio-worker-&amp;lt;id&amp;gt; · savonet/liquidsoap:v2.4.2 · station.liq генерирует панель" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="1260" height="470" as="geometry"/></mxCell>
        <mxCell id="decode" value="ПРИЁМ&lt;br&gt;input.http&lt;br&gt;max_buffer 10 c · timeout 10 c&lt;br&gt;reconnect · poll 1 c&lt;br&gt;→ PCM · raw_input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="295" y="180" width="160" height="150" as="geometry"/></mxCell>
        <mxCell id="pbox" value="ДИНАМИЧЕСКАЯ ОБРАБОТКА (PCM) · каждая включённая секция — в живом switch «panel_*_on» (вкл/выкл без перезапуска)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="475" y="150" width="600" height="220" as="geometry"/></mxCell>
        <mxCell id="eq" value="EQ&lt;br&gt;10 полос&lt;br&gt;нативные&lt;br&gt;IIR-пики&lt;br&gt;gain живьём" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="490" y="215" width="100" height="120" as="geometry"/></mxCell>
        <mxCell id="gainb" value="Усиление&lt;br&gt;amplify&lt;br&gt;panel_gain&lt;br&gt;живьём" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="600" y="215" width="95" height="120" as="geometry"/></mxCell>
        <mxCell id="comp" value="Компрессор&lt;br&gt;compress&lt;br&gt;нативный&lt;br&gt;порог/ratio/&lt;br&gt;attack/release/&lt;br&gt;makeup живьём" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="705" y="215" width="115" height="120" as="geometry"/></mxCell>
        <mxCell id="lufs" value="LUFS&lt;br&gt;loudnorm&lt;br&gt;динам. режим&lt;br&gt;ffmpeg-граф&lt;br&gt;(raw-обёртка)&lt;br&gt;на перезапуске" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="830" y="215" width="120" height="120" as="geometry"/></mxCell>
        <mxCell id="limit" value="Лимитер&lt;br&gt;limit&lt;br&gt;нативный&lt;br&gt;ceiling/attack/&lt;br&gt;release живьём" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ecf7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="215" width="100" height="120" as="geometry"/></mxCell>
        <mxCell id="bypass" value="LIVE BYPASS&lt;br&gt;switch на&lt;br&gt;panel_bypass:&lt;br&gt;raw_input ↔&lt;br&gt;buffer(proc)&lt;br&gt;без перезапуска" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="180" width="130" height="150" as="geometry"/></mxCell>
        <mxCell id="fbb" value="РЕЗЕРВ&lt;br&gt;fallback(&lt;br&gt;track_sensitive=&lt;br&gt;false): обрыв&lt;br&gt;входа → заглушка&lt;br&gt;(тишина / тон 880 Гц&lt;br&gt;/ запасной URL),&lt;br&gt;возврат — автоматом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1245" y="180" width="140" height="150" as="geometry"/></mxCell>
        <mxCell id="encode" value="КОДИРОВАНИЕ&lt;br&gt;%fdkaac&lt;br&gt;bitrate из конфига&lt;br&gt;output.icecast&lt;br&gt;fallible=true&lt;br&gt;on_connect/&lt;br&gt;on_disconnect →&lt;br&gt;panel_ice_connected&lt;br&gt;→ ADTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=9;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1405" y="180" width="110" height="150" as="geometry"/></mxCell>
        <mxCell id="latnote" value="Бюджет задержки узла ≈ 0,5–1,5 с: буфер приёма · DSP · кодирование FDK-AAC" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="300" y="455" width="720" height="22" as="geometry"/></mxCell>
        <mxCell id="metnote" value="StreamTitle: on_metadata → лог воркера ([metadata] …) — видно в панели · в потоке метаданные идут сквозь конвейер без изменений" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="470" y="485" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="cdn" value="ICECAST / CDN&lt;br&gt;приём потока&lt;br&gt;точка /station-&amp;lt;id&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="160" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="listen" value="СЛУШАТЕЛИ&lt;br&gt;web · mobile · плееры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="cdnnote" value="HLS-сегментация CDN:&lt;br&gt;+2…30 с, если применимо" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1580" y="432" width="180" height="44" as="geometry"/></mxCell>
        <mxCell id="panel" value="ПАНЕЛЬ УПРАВЛЕНИЯ&lt;br&gt;генерация station.liq из streams.json · Docker API: старт / стоп / логи / watchdog&lt;br&gt;telnet :1234 (постоянная сессия): gain, EQ 10 полос, компрессор, лимитер,&lt;br&gt;вкл/выкл секций, BYPASS — живьём, без перезапуска&lt;br&gt;статусы: input.status (вход) · var.get panel_ice_connected (выход)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="575" width="400" height="115" as="geometry"/></mxCell>
        <mxCell id="ablisten" value="A/B-ПРОСЛУШКА · панель&lt;br&gt;вход / выход станции&lt;br&gt;MP3-over-HTTP&lt;br&gt;(отдельный FFmpeg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa3c7;fontColor=#1a1a2e;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="secnote" value="Секции, включённые при старте, управляются живьём; выключенные —&lt;br&gt;появятся после перезапуска воркера. Статический BYPASS в конфиге —&lt;br&gt;ветки обработки в скрипте нет совсем. Резерв задаётся в карточке&lt;br&gt;«01 Источник» и тоже применяется при перезапуске." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1200" y="575" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTP-поток" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5a7a;strokeWidth=1.5;fontColor=#1a1a2e;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="decode"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
